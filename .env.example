# Cohart Backend Environment Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini AI Key (Used for smart summarization, multimodal analysis, and web synthesis)
GEMINI_API_KEY=your-gemini-api-key

# Self-Hosted VPS Ollama Configuration (100% Free, Zero Rate Limits for Ogun Summit)
# e.g. http://your-vps-ip:11434 or http://localhost:11434 or https://ai.yourdomain.com
OLLAMA_BASE_URL=
# Recommended lightweight models: qwen2.5:3b (2.2GB), llama3.2:3b (2.0GB), or deepseek-r1:1.5b
OLLAMA_MODEL=qwen2.5:3b
